# API Keys for AI & Data Collection
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
# SerpApi (https://serpapi.com) - tuy chon, dung thay the Google Trends khi bi rate limit 429.
# Free tier: 250 request/thang. Dan key vao day va chon "serpapi" tren UI/CLI la chay duoc.
SERPAPI_API_KEY=your_serpapi_api_key_here

# Collector Settings
REDDIT_USER_AGENT=trend-research/0.1
